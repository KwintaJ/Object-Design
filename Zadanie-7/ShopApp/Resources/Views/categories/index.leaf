<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>#(title)</title>
    <style>
        body { font-family: sans-serif; margin: 40px; background-color: #121212; color: #e0e0e0; }
        h1 { color: #2ed573; }
        .form-group { margin-bottom: 20px; max-width: 400px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; }
        input { width: 100%; padding: 8px; background: #1e1e1e; border: 1px solid #333; color: white; border-radius: 4px; }
        button { padding: 10px 15px; background: #2ed573; border: none; color: white; font-weight: bold; border-radius: 4px; cursor: pointer; }
        a { color: #aaa; text-decoration: none; margin-left: 15px; }
    </style>
</head>
<body>
    <a href="/categories/create">Dodaj kategorię</a>
    <ul>
        #for(category in categories):
        <li>#(category.name) 
            <a href="/categories/#(category.id)/edit">Edytuj</a>
            <form action="/categories/#(category.id)/delete" method="POST" style="display:inline;">
                <button type="submit">Usuń</button>
            </form>
        </li>
        #endfor
    </ul>
    <a href="/products">Powrót do produktów</a>
</body>
</html>