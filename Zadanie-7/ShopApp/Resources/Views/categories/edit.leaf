<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <title>#(title)</title>
    <style>
        body { font-family: sans-serif; margin: 40px; background-color: #121212; color: #e0e0e0; }
        h1 { color: #ff4757; }
        .form-group { margin-bottom: 20px; max-width: 400px; }
        label { display: block; margin-bottom: 5px; font-weight: bold; }
        input { width: 100%; padding: 8px; background: #1e1e1e; border: 1px solid #333; color: white; border-radius: 4px; }
        button { padding: 10px 15px; background: #ff4757; border: none; color: white; font-weight: bold; border-radius: 4px; cursor: pointer; }
        a { color: #aaa; text-decoration: none; margin-left: 15px; }
    </style>
</head>
<body>
    <h1>Edytuj kategorię: #(category.name)</h1>
    <form action="/categories/#(category.id)/edit" method="POST">
        <div>
            <label>Nowa nazwa:</label><br>
            <input type="text" name="name" value="#(category.name)" required>
        </div>
        <br>
        <button type="submit">Zaktualizuj</button>
        <a href="/categories">Anuluj</a>
    </form>
</body>
</html>